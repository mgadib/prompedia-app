# Application Configuration
# Copy this file to .env and fill in your values
#
# Production: run `npm run build` (uses mode production). Do not set debug or
# development-only env vars in production. NODE_ENV is set by Vite at build time.

# Required (production)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Sentry error tracking
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Optional: Build metadata (set by CI or build script)
# VITE_APP_VERSION=1.0.0
# VITE_BUILD_TIME=2025-01-01T00:00:00Z

# Optional: Analytics (Umami; uncomment and set for production)
# VITE_ANALYTICS_SCRIPT_URL=https://analitik.mgadib.cloud/script.js
# VITE_ANALYTICS_WEBSITE_ID=f66b51ee-e3a9-47c2-961b-18645003afe6
